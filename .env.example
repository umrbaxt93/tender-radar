# Placeholder documentation only. Never commit actual credentials.
# GitHub Actions environment secrets (agent-review, review job only):
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GitHub Actions environment variables:
GEMINI_MODEL=
CLAUDE_MODEL=
CODEX_MODEL=
ENABLE_AGENT_SCHEDULE=false
# Application runtime:
DATABASE_URL=postgresql://tender:CHANGE_ME@localhost:5432/tender_radar
TEST_DATABASE_URL=postgresql://tender:CHANGE_ME@localhost:5432/tender_radar_test
POSTGRES_USER=tender
POSTGRES_DB=tender_radar
POSTGRES_PASSWORD=
CONTACT_EMAIL=
# Your organisation's STIR, used as the E-IMZO session identity against E-Birja.
COMPANY_TIN=
CLASSIFIER_BUDGET_USD=10
OUT_DIR=out
# Source contract. Intentionally empty: the public endpoint contract is UNVERIFIED
# (docs/SOURCE_API.md). Set these only after verifying real public, unauthenticated pages.
UZEX_LIST_URL=
UZEX_DETAIL_URL=
REQUEST_INTERVAL_S=3
# Trigram similarity for merging customer names when neither side has a STIR.
# Strict on purpose: a wrong merge corrupts customer history.
ORG_MATCH_THRESHOLD=0.92
# Dashboard build + deploy. Leave empty to have the worker skip deployment entirely.
DASHBOARD_DATA_PATH=
DASHBOARD_BUILD_SCRIPT=
DASHBOARD_HTML_PATH=
DEPLOY_SSH_KEY=
DEPLOY_SSH_PORT=22
DEPLOY_TARGET=
# Offline development against labelled synthetic fixtures instead of the live source:
SOURCE_FIXTURE_DIR=
